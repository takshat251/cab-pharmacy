@{
    ViewData["Title"] = "Pharmacy Medicine Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    ~/css/styles.css
</head>
<body>
    <h1>@ViewData["Title"]</h1>
    <input type="text" id="search" placeholder="Search medicine...">
    <button onclick="searchMedicines()">Search</button>
    <table id="medicineTable">
        <thead>
            <tr>
                <th>Name</th>
                <th>Expiry Date</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Brand</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <script src="~/js/app.js"></script>
</body>
</html>
